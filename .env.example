# Copy to .env and adjust if you want. These PUBLIC demo creds are the defaults,
# so .env is optional locally — its real purpose is to practice the secrets pattern.
DEMO_BASE_URL=https://www.saucedemo.com/
DEMO_USER=standard_user
DEMO_PASSWORD=secret_sauce

# API practice target (Week 4). Public sandbox creds — safe defaults.
BOOKER_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USER=admin
BOOKER_PASSWORD=password123
